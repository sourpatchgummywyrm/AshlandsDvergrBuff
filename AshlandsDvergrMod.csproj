<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AshlandsDvergrMod</AssemblyName>
    <RootNamespace>AshlandsDvergrMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- OS-adaptive Steam Valheim paths (can be overridden via -p:ValheimDir="...") -->
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(OS)' != 'Windows_NT'">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</ValheimDir>

    <ManagedDir Condition="'$(OS)' == 'Windows_NT'">$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <ManagedDir Condition="'$(OS)' != 'Windows_NT'">$(ValheimDir)/Valheim.app/Contents/Resources/Data/Managed</ManagedDir>

    <BepInExCoreDir Condition="'$(OS)' == 'Windows_NT'">$(ValheimDir)\BepInEx\core</BepInExCoreDir>
    <BepInExCoreDir Condition="'$(OS)' != 'Windows_NT'">$(ValheimDir)/BepInEx/core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PackageThunderstore" AfterTargets="Build">
    <PropertyGroup>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ProjectDir)manifest.json')), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
      <ThunderstoreStagingDir>$(IntermediateOutputPath)ThunderstorePackage</ThunderstoreStagingDir>
      <ThunderstoreZipPath>$(ProjectDir)AshlandsDvergrBuff-$(ManifestVersion).zip</ThunderstoreZipPath>
    </PropertyGroup>
    <ItemGroup>
      <ThunderstoreFiles Include="$(TargetPath)" />
      <ThunderstoreFiles Include="$(ProjectDir)manifest.json" />
      <ThunderstoreFiles Include="$(ProjectDir)icon.png" />
      <ThunderstoreFiles Include="$(ProjectDir)README.md" />
      <ThunderstoreFiles Include="$(ProjectDir)CHANGELOG.md" Condition="Exists('$(ProjectDir)CHANGELOG.md')" />
    </ItemGroup>
    <RemoveDir Directories="$(ThunderstoreStagingDir)" />
    <MakeDir Directories="$(ThunderstoreStagingDir);$(ProjectDir)dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)" />
    <Copy SourceFiles="@(ThunderstoreFiles)" DestinationFolder="$(ThunderstoreStagingDir)" />
    <ZipDirectory SourceDirectory="$(ThunderstoreStagingDir)" DestinationFile="$(ThunderstoreZipPath)" Overwrite="true" />
    <Copy SourceFiles="$(ThunderstoreZipPath)" DestinationFolder="$(ProjectDir)dist" />
    <Copy SourceFiles="$(ThunderstoreZipPath)" DestinationFolder="$(ProjectDir)../dist" Condition="Exists('$(ProjectDir)../dist')" />
  </Target>

</Project>
